AI_CONSULTATION_APP_NAME=AI Consultation Platform API
AI_CONSULTATION_APP_ENVIRONMENT=development
AI_CONSULTATION_DEBUG=true
AI_CONSULTATION_API_V1_PREFIX=/api/v1
# Replace username and password with local credentials; do not commit this file as .env.
AI_CONSULTATION_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ai_consultation
AI_CONSULTATION_CORS_ORIGINS=["http://localhost:5173"]
AI_CONSULTATION_LOG_LEVEL=INFO
AI_CONSULTATION_AI_PROVIDER=mock
AI_CONSULTATION_AI_MODEL=gpt-5-mini
AI_CONSULTATION_AI_TIMEOUT_SECONDS=30
# Required only when AI_PROVIDER=openai
AI_CONSULTATION_OPENAI_API_KEY=
